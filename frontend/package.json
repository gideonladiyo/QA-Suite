{
  "name": "qa-portal-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src vite.config.ts eslint.config.js index.html",
    "format:check": "prettier --check src vite.config.ts eslint.config.js index.html",
    "test": "vitest run",
    "test:worker": "node scripts/smoke-micro-worker.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "jsonc-parser": "3.3.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.42",
    "vue-router": "^4.5.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
